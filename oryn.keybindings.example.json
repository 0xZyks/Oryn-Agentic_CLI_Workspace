{
  "Super": "Ctrl",
  "LeaderTimeoutMilliseconds": 1000,
  "Workspace": {
    "Quit": ["Super+Q"],
    "EditKeybindings": ["Super+K"],
    "OpenMenu": ["F10"],
    "ResizeSmaller": ["Super+Left"],
    "ResizeLarger": ["Super+Right"],
    "ToggleDock": ["Super+D"],
    "DockLeft": ["Super+Shift+Left"],
    "DockRight": ["Super+Shift+Right"]
  },
  "Panels": {
    "NextPanel": ["Super+Tab"],
    "PreviousPanel": ["Super+Shift+Tab"]
  },
  "Tabs": {
    "ToggleTabFocus": ["Super+Enter", "F6"],
    "NextTab": ["Right", "Tab"],
    "PreviousTab": ["Left"],
    "ConfirmTab": ["Enter"],
    "ReturnToContent": ["Esc"]
  },
  "Explorer": {
    "MoveUp": ["Up"],
    "MoveDown": ["Down"],
    "OpenSelection": ["Enter"],
    "ExpandSelection": ["Right"],
    "Collapse": ["Left"]
  },
  "Graph": {
    "GraphZoomIn": ["PageUp", "Plus", "Shift+Plus"],
    "GraphZoomOut": ["PageDown", "Minus"],
    "GraphResetZoom": ["Home"],
    "GraphEnterComponent": ["Enter"],
    "GraphExitComponent": ["Esc"],
    "GraphOptions": ["Alt+Enter"]
  },
  "Content": {
    "ContentUp": ["Up"],
    "ContentDown": ["Down"],
    "ContentLeft": ["Left"],
    "ContentRight": ["Right"],
    "ToggleHistory": ["Tab"]
  },
  "Text": {
    "TextSubmit": ["Enter"],
    "TextNewline": ["Shift+Enter"],
    "TextSelectAll": ["Ctrl+A"],
    "TextCopy": ["Ctrl+C"],
    "TextCut": ["Ctrl+X"],
    "TextPaste": ["Ctrl+V"]
  },
  "Dialog": {
    "DialogClose": ["Esc"],
    "DialogNext": ["Down", "Tab"],
    "DialogPrevious": ["Up", "Shift+Tab"],
    "DialogConfirm": ["Enter"],
    "BindingNext": ["Tab"],
    "BindingPrevious": ["Shift+Tab"],
    "BindingApply": ["Alt+A"],
    "BindingSave": ["Alt+S"]
  },
  "Navbar": {
    "ToggleNavbarFocus": ["Shift+Tab", "F9"],
    "NextNavbar": ["Right", "Tab"],
    "PreviousNavbar": ["Left"],
    "ConfirmNavbar": ["Enter"],
    "LeaveNavbar": ["Esc"]
  }
}
